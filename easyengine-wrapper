#!/bin/sh
# Purpose: Routes 'ee' commands to Docker Compose

if [ "$1" = "cli" ] && [ "$2" = "update" ]; then
    sudo docker compose -f /opt/easyengine/docker-compose.yml pull
else
    # Extract site domain from current host path
    SITE_DOMAIN=$(pwd | sed -n 's|.*/sites/\([^/]*\).*|\1|p')

    if [ -n "$SITE_DOMAIN" ]; then
        if [ "$1" = "site" ] && [ $# -eq 2 ]; then
            # ee site info/update/delete -> inject domain as 3rd arg
            set -- "$1" "$2" "$SITE_DOMAIN"
        elif [ "$1" = "shell" ]; then
            # Check if domain not already passed (no arg without leading --)
            HAS_DOMAIN=0
            for arg in "$@"; do
                case "$arg" in
                    --*) ;;  # skip flags
                    shell) ;; # skip subcommand itself
                    *) HAS_DOMAIN=1 ;;
                esac
            done
            if [ "$HAS_DOMAIN" = "0" ]; then
                set -- "$1" "$SITE_DOMAIN" "${@:2}"
            fi
        fi
    fi

    sudo docker compose -f /opt/easyengine/docker-compose.yml run --rm \
        easyengine ee "$@"
fi
