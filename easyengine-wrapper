#!/bin/sh
if [ "$1" = "cli" ] && [ "$2" = "update" ]; then
    sudo docker compose -f /opt/easyengine/docker-compose.yml pull
    exit 0
fi

# Quote từng argument đúng cách trước khi truyền vào sh -c
ARGS=$(printf ' %q' "$@")

sudo docker compose -f /opt/easyengine/docker-compose.yml run --rm \
    easyengine sh -c "cd '$(pwd -L)' && ee$ARGS"
