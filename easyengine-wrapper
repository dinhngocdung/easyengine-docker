#!/bin/sh
if [ "$1" = "cli" ] && [ "$2" = "update" ]; then
    echo "YOU ARE USING THE EASYENGINE-DOCKER VERSION."
    echo "- This update action will pull the latest Docker images."
    echo "- To rollback to an older version, you need to change the image tags in /opt/easyengine/docker-compose.yml"
    echo ""
    
    # Prompt for confirmation
    printf "Do you want to proceed? [y/N]: "
    read -r response
    
    case "$response" in
        [yY][eE][sS]|[yY]) 
            COMPOSE_FILE="/opt/easyengine/docker-compose.yml"
            IMAGE_NAME="dinhngocdung/easyengine:latest"
            
            OLD_IMG_ID=$(sudo docker inspect --format='{{.Id}}' $IMAGE_NAME 2>/dev/null)
            
            echo "Pulling latest Docker images..."
            if sudo docker compose -f $COMPOSE_FILE pull; then
                
                NEW_IMG_ID=$(sudo docker inspect --format='{{.Id}}' $IMAGE_NAME 2>/dev/null)
                
                if [ "$OLD_IMG_ID" = "$NEW_IMG_ID" ] && [ -n "$OLD_IMG_ID" ]; then
                    echo ""
                    echo "EasyEngine is already up to date."
                else
                    echo ""
                    echo "New images detected! Running migrations..."
                    echo "---------------------------------------------------------"
                    
                    # Chạy migrations qua "run --rm -T": không cần container nền tạm,
                    # -T tắt TTY nên "ee cli info" không bị treo chờ input khi chạy non-interactive.
                    sudo docker compose -f "$COMPOSE_FILE" run --rm -T easyengine \
                        sh -c "cd '$(pwd -L)' && ee cli info" < /dev/null
                    MIGRATE_STATUS=$?
                    
                    echo "---------------------------------------------------------"
                    if [ $MIGRATE_STATUS -eq 0 ]; then
                        echo "Update and migration completed successfully!"
                    else
                        echo "Error: Migration step failed (exit code $MIGRATE_STATUS)."
                        exit $MIGRATE_STATUS
                    fi
                fi
            else
                echo "Error: Failed to pull Docker images."
                exit 1
            fi
            ;;
        *)
            echo "Update cancelled."
            exit 1
            ;;
    esac
    exit 0
fi
# ==========================================
# CÁC LỆNH EE BÌNH THƯỜNG KHÁC SẼ CHẠY Ở ĐÂY
# ==========================================
ARGS=$(printf ' %q' "$@")
sudo docker compose -f /opt/easyengine/docker-compose.yml run --rm \
    easyengine sh -c "cd '$(pwd -L)' && ee$ARGS"